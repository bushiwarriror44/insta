# Copy to .env and fill in your values. Never commit .env to git.

# --- Database ---
DATABASE_URL=sqlite:///data/app.db

# --- Paths ---
DATA_DIR=data
SESSIONS_DIR=data/sessions
DEVICES_DIR=data/devices
PLAYWRIGHT_DIR=data/playwright
VIDEO_SOURCE_DIR=data/videos/source
VIDEO_OUT_DIR=data/videos/out
REFERENCE_DIR=data/reference

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=data/app.log

# --- Telegram alerts (optional but recommended) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Behavior tuning ---
DEFAULT_DAILY_POST_CAP=3
DEFAULT_MIN_GAP_HOURS=4
DEFAULT_ACTIVE_HOUR_START=10
DEFAULT_ACTIVE_HOUR_END=23

# --- Docker: set SKIP_AUTO_INIT_DB=1 to skip schema init on every container start ---
# SKIP_AUTO_INIT_DB=1

# --- Proxy health-check ---
PROXY_HEALTH_URL=https://api.ipify.org?format=json
PROXY_HEALTH_TIMEOUT_SEC=15

# --- Playwright ---
PLAYWRIGHT_HEADLESS=true

# --- Interactive browser (Docker: reels-api sets BROWSER_VNC_ENABLED=true) ---
BROWSER_VNC_ENABLED=false
BROWSER_SESSION_TIMEOUT_MIN=15
# Cap concurrent noVNC Chromium sessions (each can use hundreds of MB).
BROWSER_MAX_SESSIONS=1
BROWSER_LIGHTWEIGHT=true

# --- Scheduler ---
SCHEDULER_TZ=UTC
WORKER_POLL_INTERVAL_SEC=20
JOB_MAX_ATTEMPTS=4

# --- Admin web UI / API ---
# Empty ADMIN_TOKEN disables authentication (only use behind VPN/localhost).
ADMIN_TOKEN=
API_HOST=0.0.0.0
API_PORT=8000
UPLOAD_MAX_MB=512
IMAGE_COMPRESS_MAX_EDGE=1920
IMAGE_COMPRESS_QUALITY=85
# Browser origin of the UI. Docker UI is :3000; add http://YOUR_SERVER_IP:3000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173
# Signed media download links (empty = dev default in code; set in production).
MEDIA_URL_SECRET=
MEDIA_LINK_TTL_SECONDS=3600

# --- Content agent / chat ---
# Docker / admin VPS: leave AGENT_BASE_URL empty (chat waits for external GPU).
# Local Ollama: omit this line entirely so the default http://localhost:11434/v1 applies.
# Do NOT copy "AGENT_BASE_URL=" alone — empty string disables local Ollama.
AGENT_BACKEND=openai-compat
# Default in code is qwen3:8b; match compose ollama-pull profile if you use it.
AGENT_MODEL=qwen3:8b
AGENT_API_KEY=
AGENT_TIMEOUT_SECONDS=600
ASSISTANT_TIMEOUT_SECONDS=180
PANEL_BASE_URL=http://127.0.0.1:3000
WORKER_AUTOSTART=false
OLLAMA_AUTOSTART=false

# --- Video render ---
# auto = try VIDEO_BACKEND_CHAIN in order until one returns a clip.
VIDEO_BACKEND=auto
VIDEO_BACKEND_CHAIN=fal,huggingface,pollinations,local,hfspace
GENERATION_POLL_SECONDS=5
GENERATION_TIMEOUT_SECONDS=900
FAL_API_KEY=
FAL_MODEL=fal-ai/wan-25-preview/text-to-video
FAL_MODEL_I2V=fal-ai/wan-25-preview/image-to-video
FAL_MODEL_V2V=fal-ai/wan-25-preview/image-to-video
HF_TOKEN=
HF_VIDEO_MODEL=Wan-AI/Wan2.1-T2V-1.3B
# Public Pollinations video URL; empty disables this backend.
POLLINATIONS_VIDEO_URL=https://gen.pollinations.ai/video
# Optional; invalid key causes 403 — remove line or set a valid Pollinations API key
POLLINATIONS_API_KEY=
# Self-hosted Wan / Comfy HTTP. POST {prompt, duration_s, width, height} → MP4.
WAN_BASE_URL=
# When WAN is set, auto chain skips local until operator confirms (chat /renders modal).
LOCAL_RENDER_REQUIRES_CONFIRM=true
WAN_API_KEY=
# Salad Cloud container group Start/Stop from /administration (not the worker toggle).
# Key never belongs in chat, docs, or commits. Names are the portal slugs.
SALAD_API_KEY=
SALAD_ORGANIZATION=
SALAD_PROJECT=
SALAD_CONTAINER_GROUP=
# Stop the Salad group after this many idle minutes (chat or local render).
# 0 disables. Start after Stop downloads the image again.
SALAD_IDLE_STOP_MINUTES=120
# Optional Gradio Space, last in the chain (experimental).
HF_SPACE_ID=
HF_SPACE_API_NAME=predict
REFERENCE_MAX_BYTES=262144
REFERENCE_TIMEOUT_SECONDS=15
